# Copy this file to .env locally. Never commit real secrets.
PORT=8787
HOST=127.0.0.1
DOWNLOAD_DIR=./downloads
CORS_ORIGIN=http://127.0.0.1:5500

# Supabase Auth validates the signed-in user's access token.
# Use the same Supabase project as EL CLASSCO.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# For local testing only. Bind HOST=127.0.0.1 so it is not public.
